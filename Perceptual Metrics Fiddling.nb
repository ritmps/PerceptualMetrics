Cell["3. Test it in Python first", "Title",ExpressionUUID->"69b00c22-da2c-42dc-938f-7e4a53bdff8a"],

Cell["Before touching WL, confirm the environment works.", "Text",ExpressionUUID->"2d0dea8c-876a-44c5-a8f1-a1324e9b50c4"],

Cell["For example: ", "Text",ExpressionUUID->"0c41a14e-2e16-4cbc-9a9e-a680ff0ed934"],

Cell[".venv/bin/python", "ExternalLanguage",
 CellEvaluationLanguage->
  "Shell",ExpressionUUID->"0cbfc405-b9c5-4b52-af2f-e548f77dee9c"],

Cell["then: ", "Text",ExpressionUUID->"3882946b-cb30-4ca8-bcf0-013213d8661c"],

Cell["import metrics_bridge", "ExternalLanguage",
 CellEvaluationLanguage->
  "Python",ExpressionUUID->"ad771aba-296c-4212-8aa7-e89b612d2824"],

Cell["If that imports cleanly, the environment is basically ready.", "Text",ExpressionUUID->"c9e3ab05-f12e-4737-9b96-3e28d2a2f0a4"],

