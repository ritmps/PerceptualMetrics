Cell[CellGroupData[{

Cell["7. Example usage in WL", "Title",ExpressionUUID->"b572c544-4ea4-4223-8d6a-7c2affd8925b"],

Cell["Suppose: ", "Text",ExpressionUUID->"2148d2ef-23ba-4918-bf59-a36a84f88347"],

Cell[TextData[{
 "your project lives in ",
 Cell[BoxData[Cell["/path/to/project",
   Background->None,ExpressionUUID->"320a1513-ab40-4c38-88f1-dee5920e9d6d"]], 
  "InlineCode",ExpressionUUID->"61a7c7d0-773f-4836-9038-f9281f0fce94"]
}], "Item",ExpressionUUID->"b84bce36-3aca-4a7e-b077-a186d9513e78"],

Cell[TextData[{
 "your Python is ",
 Cell[BoxData[Cell["/path/to/project/.venv/bin/python",
   Background->None,ExpressionUUID->"31bff71d-1828-4b0b-94ad-63a8f8086237"]], 
  "InlineCode",ExpressionUUID->"8f2617a6-0c3b-4440-82f6-141c9f16a05e"]
}], "Item",ExpressionUUID->"8a7a28b5-2cdc-4582-9f06-1570edcb590b"],

Cell["then: ", "CodeText",ExpressionUUID->"cf8fda33-6502-4e74-95ee-24fa28f36533"],

Cell[BoxData[
 RowBox[{
  RowBox[{"session", "=", 
   RowBox[{"startMetricsSession", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{"\"\</path/to/project/.venv/bin/python\>\"", ",", 
     "\[IndentingNewLine]", "   ", "\"\</path/to/project\>\""}], 
    "\[IndentingNewLine]", "   ", "]"}]}], ";"}]], "Input",ExpressionUUID->\
"7a4c1adf-2e0e-40a4-9755-b43b50812752"],

Cell["Then test with example images: ", "CodeText",ExpressionUUID->"9224aa2d-e881-4de9-91b5-11886f125511"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"image1", "=", 
   RowBox[{"Import", "[", "\"\<ExampleData/ocelot.jpg\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"image2", "=", 
    RowBox[{"Blur", "[", 
     RowBox[{"image1", ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"lpipsDistance", "[", 
  RowBox[{"session", ",", "image1", ",", "image2"}], "]"}]}], "Input",Expressi\
onUUID->"79fa1555-dfcf-4ba8-9def-9974eb0faa1b"],

Cell["You should get a nonnegative real number.", "Text",ExpressionUUID->"d82b27fa-21e0-4d84-b31e-f6d1953b23a9"],

Cell["You can also compare networks: ", "CodeText",ExpressionUUID->"73033df1-b620-432f-be16-9095b2892c13"],

Cell[BoxData[{
 RowBox[{"lpipsDistance", "[", 
  RowBox[{"session", ",", "image1", ",", "image2", ",", "\"\<alex\>\""}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"lpipsDistance", "[", 
  RowBox[{"session", ",", "image1", ",", "image2", ",", "\"\<vgg\>\""}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"lpipsDistance", "[", 
  RowBox[{"session", ",", "image1", ",", "image2", ",", "\"\<squeeze\>\""}], 
  "]"}]}], "Input",ExpressionUUID->"1b7e947a-cac1-44bf-8145-d1272da7f51d"],

