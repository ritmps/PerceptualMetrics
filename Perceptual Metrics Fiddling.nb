Cell[CellGroupData[{

Cell["2. Create a small Python module", "Title",ExpressionUUID->"8c41dc69-4203-4eaa-a138-abfd5884ceae"],

Cell[TextData[{
 "Make a file like ",
 Cell[BoxData[Cell["metrics_bridge.py",
   Background->None,ExpressionUUID->"c5c66e00-cbbf-4a80-b45c-dd58ef4de15f"]], 
  "InlineCode",ExpressionUUID->"2497668e-ec5d-4726-9b55-ec51bd6c5d1d"],
 " in your project. "
}], "Text",ExpressionUUID->"90c21ea2-89ef-4b26-bb46-c805a9f0139a"],

Cell["\<\
from pathlib import Path

import lpips
import torch
from PIL import Image


_models = {}


def _get_model(net=\"alex\"):
    key = (\"lpips\", net)
    if key not in _models:
        _models[key] = lpips.LPIPS(net=net)
        _models[key].eval()
    return _models[key]


def _load_image_tensor(path):
    image = Image.open(path).convert(\"RGB\")
    tensor = lpips.im2tensor(lpips.load_image(str(path)))
    return tensor


def lpips_distance(path1, path2, net=\"alex\"):
    path1 = str(Path(path1))
    path2 = str(Path(path2))

    model = _get_model(net)
    image1 = _load_image_tensor(path1)
    image2 = _load_image_tensor(path2)

    with torch.no_grad():
        value = model.forward(image1, image2)

    return float(value.item())\
\>", "ExternalLanguage",
 CellEvaluationLanguage->
  "Python",ExpressionUUID->"421a0316-9d31-45b1-91a7-ca4a5f24a5d5"],

Cell[CellGroupData[{

Cell["Notes", "Section",ExpressionUUID->"b043f277-c3da-4733-b306-fde09af68d19"],

Cell[TextData[{
 "the module caches loaded LPIPS models in ",
 Cell[BoxData[Cell["_models",
   Background->None,ExpressionUUID->"c13dfc55-b78d-47f2-86e2-5ce1824b19dd"]], 
  "InlineCode",ExpressionUUID->"be2ec9ed-e07a-45f0-85d9-0b5f07cd3b81"]
}], "Item",ExpressionUUID->"195647b9-1d72-4249-b9da-60392c33076f"],

Cell["that matters if WL keeps the Python session alive", "Item",ExpressionUUID->"be563c6f-25bf-467e-a728-b33bc437f764"],

Cell["using paths keeps the interface simple", "Item",ExpressionUUID->"412ca1ed-41b8-47b4-9243-afbd840cf21b"],

Cell[TextData[{
 "You could simplify ",
 Cell[BoxData[Cell["_load_image_tensor",
   Background->None,ExpressionUUID->"8ee869ed-1d63-48ae-9e86-c019fb7c5ed5"]], 
  "InlineCode",ExpressionUUID->"a649b2d5-117b-4b2e-ac73-b488c04cd095"],
 " further, but this version stays close to the LPIPS package\
\[CloseCurlyQuote]s expected preprocessing. "
}], "Text",ExpressionUUID->"aeab51fc-0fc6-48f2-86ac-a4a07e6790de"],

