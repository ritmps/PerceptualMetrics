Cell[CellGroupData[{

Cell["5. A practical WL wrapper", "Title",ExpressionUUID->"07d66822-05c5-48ac-8a0f-632a36bbbc2f"],

Cell["\<\
Here is a straightforward first version. You will likely only need to adapt \
the Python path and the module directory. \
\>", "Text",ExpressionUUID->"e33313d5-b9f8-477f-bbba-b947e61345d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"startMetricsSession", ",", "lpipsDistance"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"startMetricsSession", "[", 
    RowBox[{"pythonExecutable_String", ",", "moduleDirectory_String"}], "]"}],
    ":=", "\[IndentingNewLine]", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "session", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"session", "=", 
       RowBox[{"StartExternalSession", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"\"\<Python\>\"", ",", 
          RowBox[{"\"\<Evaluator\>\"", "->", "pythonExecutable"}]}], "}"}], 
        "\[IndentingNewLine]", "    ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", "\[IndentingNewLine]", "  ", 
      RowBox[{"ExternalEvaluate", "[", "\[IndentingNewLine]", "   ", 
       RowBox[{"session", ",", "\[IndentingNewLine]", "   ", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", "\[IndentingNewLine]", 
          "     ", "\"\<import sys; sys.path.insert(0, r'''`dir`'''); import \
metrics_bridge\>\"", "\[IndentingNewLine]", "     ", "]"}], "[", 
         RowBox[{"<|", 
          RowBox[{"\"\<dir\>\"", "->", "moduleDirectory"}], "|>"}], "]"}]}], 
       "\[IndentingNewLine]", "   ", "]"}], ";", "\[IndentingNewLine]", "  ", 
      "\[IndentingNewLine]", "  ", "session"}]}], "\[IndentingNewLine]", "  ",
     "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lpipsDistance", "[", "\[IndentingNewLine]", "   ", 
   RowBox[{
   "session_", ",", "\[IndentingNewLine]", "   ", "image1_Image", ",", 
    "\[IndentingNewLine]", "   ", "image2_Image", ",", "\[IndentingNewLine]", 
    "   ", 
    RowBox[{"net_", ":", " ", "\"\<alex\>\""}]}], "\[IndentingNewLine]", 
   "   ", "]"}], ":=", "\[IndentingNewLine]", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"file1", ",", "file2", ",", "result"}], "}"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"file1", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"CreateDirectory", "[", "]"}], ",", "\"\<image1.png\>\""}], 
        "}"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
     RowBox[{"file2", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"DirectoryName", "[", "file1", "]"}], 
         ",", "\"\<image2.png\>\""}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"Export", "[", 
      RowBox[{"file1", ",", "image1"}], "]"}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"Export", "[", 
      RowBox[{"file2", ",", "image2"}], "]"}], ";", "\[IndentingNewLine]", 
     "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"result", "=", 
      RowBox[{"ExternalEvaluate", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{"session", ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          
          RowBox[{"\"\<Command\>\"", 
           "->", "\"\<metrics_bridge.lpips_distance\>\""}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Arguments\>\"", "->", 
           RowBox[{"{", 
            RowBox[{"file1", ",", "file2", ",", "net"}], "}"}]}]}], 
         "\[IndentingNewLine]", "      ", "|>"}]}], "\[IndentingNewLine]", 
       "    ", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", "result"}]}], "\[IndentingNewLine]", "  ", 
   "]"}]}]}], "Input",ExpressionUUID->"f0de9f9b-0356-4021-ab7d-e193a86d10a5"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
