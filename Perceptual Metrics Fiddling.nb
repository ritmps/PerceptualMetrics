Cell["yes - let's start with this", "ChatInput",
 CellChangeTimes->{{3.99596323605407*^9, 3.995963249891912*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"1d526e02-dab2-46f6-9876-f584bb4124fb"],

Cell[TextData[{
 "Great \[LongDash] let\[CloseCurlyQuote]s start with a **clean WL + ",
 StyleBox["uv", "TI"],
 " + Python module setup** that you can expand later."
}], "Text",ExpressionUUID->"60739a88-8490-4952-bc18-ce94da72293d"],

Cell["I\[CloseCurlyQuote]d suggest this structure: ", "Text",ExpressionUUID->"cf611b87-e875-4458-a163-b90f1d1af571"],

Cell[TextData[{
 StyleBox["uv", "TI"],
 " manages the Python environment"
}], "Item",ExpressionUUID->"6ba8ed95-b6e0-4a82-84e6-34d9e2ac037a"],

Cell["a small Python file exposes metric functions", "Item",ExpressionUUID->"23f78129-c3d1-418d-85f3-1b07c674fa3c"],

Cell["WL starts a Python session and calls those functions", "Item",ExpressionUUID->"4e28a8d3-1c52-467c-9651-6e8eb9858e48"],

Cell[TextData[{
 "first version uses ",
 StyleBox["image file paths",
  FontWeight->Bold]
}], "Item",ExpressionUUID->"a2736017-841f-42d9-b3fb-72ee081c9f6a"],

Cell["\<\
later we can upgrade to persistent model caching and more metrics\
\>", "Item",ExpressionUUID->"4d07e986-95bf-4741-bf1c-f827c6511fdb"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"a5867875-c408-495b-88ae-b46bfbd39410"],

Cell[CellGroupData[{

Cell[TextData[{
 "1. Create a ",
 StyleBox["uv", "TI"],
 " environment"
}], "Title",ExpressionUUID->"ed30ccc9-756c-49b1-a789-355f891f76c5"],

Cell["In your project directory: ", "Text",ExpressionUUID->"20c95c0a-91c5-419e-9f3c-0b21d2142a8e"],

Cell["\<\
uv venv .venv
uv pip install torch torchvision lpips pillow\
\>", "ExternalLanguage",
 CellEvaluationLanguage->
  "Shell",ExpressionUUID->"6a354b90-9306-4e12-9050-a4cd59281cc6"],

Cell["You may also want: ", "Text",ExpressionUUID->"011a518b-8bb2-4649-a4eb-5187b3fe1ce6"],

Cell["uv pip install numpy", "ExternalLanguage",
 CellEvaluationLanguage->
  "Shell",ExpressionUUID->"b4a71fb5-964b-4510-b931-52c79bd32d6d"],

Cell["If you plan to add more metrics later, that\[CloseCurlyQuote]s easy.", \
"Text",ExpressionUUID->"ec968d47-236a-44aa-8b31-34dec0b9719e"],

Cell["Your Python executable will typically be: ", "Text",ExpressionUUID->"6f62a91a-14cc-478b-8b3d-dd9e0e00da1f"],

Cell[TextData[{
 "macOS/Linux: ",
 Cell[BoxData[Cell[".venv/bin/python",
   Background->None,ExpressionUUID->"52cf3869-a921-4848-a0c2-dcb63487c29e"]], 
  "InlineCode",ExpressionUUID->"0d375dfa-894f-4a9f-a1e7-e55ebea56a77"]
}], "Item",ExpressionUUID->"a92a4564-07ed-4020-b247-bcf8e4b8a8f6"],

Cell[TextData[{
 "Windows: ",
 Cell[BoxData[Cell[".venv\\Scripts\\python.exe",
   Background->None,ExpressionUUID->"3969fa04-1c09-472f-80de-1e55b782ce7b"]], 
  "InlineCode",ExpressionUUID->"3d71c81d-01bb-4b57-a7eb-bc3435219912"]
