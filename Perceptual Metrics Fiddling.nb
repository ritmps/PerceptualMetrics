Cell[CellGroupData[{

Cell["4. Connect Wolfram Language to that Python", "Title",ExpressionUUID->"99afe955-0dd1-41d0-bfc6-cd8f4cf444ba"],

Cell[TextData[{
 "The cleanest route is to start a Python external session with the exact \
interpreter from your ",
 StyleBox["uv", "TI"],
 " environment."
}], "Text",ExpressionUUID->"14a67d2c-4744-4b7e-8bb0-32a11d87e92a"],

Cell[TextData[{
 "A first diagnostic step is to inspect available Python evaluators with ",
 ButtonBox["FindExternalEvaluators",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/FindExternalEvaluators"],
 "."
}], "Text",ExpressionUUID->"51d4db46-4401-4252-a347-dfbec6a5f9f9"],

Cell["Then start a session using the specific executable.", "Text",ExpressionUUID->"01d41330-7761-4523-aa7e-efc8b432cdbd"],

Cell[TextData[{
 "A common pattern is to use an ",
 ButtonBox["ExternalEvaluatorObject",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ExternalEvaluatorObject"],
 " or a configured Python evaluator and then call ",
 ButtonBox["StartExternalSession",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/StartExternalSession"],
 "."
}], "Text",ExpressionUUID->"2027984b-62ae-4358-9f25-a0cf3f28d700"],

Cell["\<\
Because the exact registration details can vary a bit by setup, the most \
reliable idea is: \
\>", "Text",ExpressionUUID->"e936e562-ef8a-4d93-919d-222f594d78db"],

Cell[TextData[{
 "identify the ",
 StyleBox["uv", "TI"],
 " Python executable"
}], "Item",ExpressionUUID->"4379f434-ee0b-4fb5-bfa1-7575eeca709b"],

Cell["tell WL to use that executable", "Item",ExpressionUUID->"6a15494c-c520-473b-b94e-39db31c4db3e"],

Cell["keep the returned session object", "Item",ExpressionUUID->"23bac79c-d253-436e-9c48-e2bb2b76940b"],

Cell["load your module once", "Item",ExpressionUUID->"3fdaf83c-0b5b-4dd4-bf2f-593910543de7"],

