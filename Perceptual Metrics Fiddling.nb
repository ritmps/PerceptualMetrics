Cell[CellGroupData[{

Cell["8. Why this is a good starting point", "Title",ExpressionUUID->"a2c4383a-c5b6-47d5-aa83-5c6359efad43"],

Cell["This gives you: ", "Text",ExpressionUUID->"6f1c3136-2c0b-4b6f-b455-b6a103ff7751"],

Cell[TextData[{
 StyleBox["faithful metric implementation",
  FontWeight->Bold],
 " via Python"
}], "Item",ExpressionUUID->"f8f50bb0-ea9e-4297-a7d8-4f6ecf5eb0b9"],

Cell[TextData[StyleBox["simple WL API",
 FontWeight->Bold]], "Item",ExpressionUUID->"9c676d20-178a-4608-b9ec-830459a9506e"],

Cell[TextData[StyleBox["persistent Python state",
 FontWeight->Bold]], "Item",ExpressionUUID->"a550a3aa-781a-445a-9b01-b0d4e3f6c3ee"],

Cell[TextData[StyleBox["model caching",
 FontWeight->Bold]], "Item",ExpressionUUID->"ed0ac927-7caf-4692-84da-3612c4057cc4"],

Cell["easy extension to more metrics later", "Item",ExpressionUUID->"d92a0b46-5ff4-48a5-8c00-9d51f6478d5c"],

Cell["You can grow this into a general bridge such as: ", "Text",ExpressionUUID->"3eb920b9-8223-4892-8dec-0d5fbfc2806f"],

Cell[TextData[Cell[BoxData[Cell["lpipsDistance[path1, path2]",
  Background->None,ExpressionUUID->
  "ea8cb1fa-4da6-4328-b078-7c1e11af3a6e"]], \
"InlineCode",ExpressionUUID->"01e5d452-f14b-48fc-b8e8-6237ddaff198"]], "Item",\
ExpressionUUID->"88e8bdda-e0dc-4e08-9710-2442323a8581"],

Cell[TextData[Cell[BoxData[Cell["ssimDistance[...]",
  Background->None,ExpressionUUID->
  "72dcb998-d9c9-44c6-affd-5a01e00d0dec"]], \
"InlineCode",ExpressionUUID->"c24b767a-e6b2-477d-a6b3-9a26bde0a5c1"]], "Item",\
ExpressionUUID->"cf31df70-629b-49fc-8051-8e77800e9126"],

Cell[TextData[Cell[BoxData[Cell["clipSimilarity[...]",
  Background->None,ExpressionUUID->
  "67881cf2-b27f-4446-a293-edbe6aa0dfb5"]], \
"InlineCode",ExpressionUUID->"db138778-c894-4cb4-88bd-93473e9f502e"]], "Item",\
ExpressionUUID->"0146fcd9-f9e5-4362-acfe-608c0bbb4a1b"],

Cell[TextData[Cell[BoxData[Cell["batchMetric[...]",
  Background->None,ExpressionUUID->
  "4e9a0500-1c9b-4cc0-bab0-5a74be1cb0e6"]], \
"InlineCode",ExpressionUUID->"26086e51-36f3-48d4-a471-6d659a91735a"]], "Item",\
ExpressionUUID->"20b940aa-2574-457f-9fc9-b5dce42c9ec3"],

