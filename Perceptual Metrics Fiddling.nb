Cell[CellGroupData[{

Cell["6. Suggested improvements to the WL wrapper", "Title",ExpressionUUID->"ad4ac67e-184e-415a-abd4-615d9fc55489"],

Cell["\<\
The first wrapper works conceptually, but I\[CloseCurlyQuote]d refine it a \
little.\
\>", "Text",ExpressionUUID->"5c11cfda-f7f8-4228-9739-c5a753e68f97"],

Cell["For example: ", "Text",ExpressionUUID->"cd0ffc3a-10cc-42e4-8e26-971d1fcc5d4a"],

Cell[TextData[{
 "use ",
 ButtonBox["CreateTemporary",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/CreateTemporary"],
 " or a temp directory helper"
}], "Item",ExpressionUUID->"4f3c7c10-b2c5-46ce-8fdc-894b680e9229"],

Cell["ensure cleanup of exported files", "Item",ExpressionUUID->"62b08313-1d94-4525-a723-8a74d5593d23"],

Cell["\<\
validate image sizes if your metric assumes matching dimensions\
\>", "Item",ExpressionUUID->"88df64f2-ccc6-486e-ae3b-b510d1b8675e"],

Cell["optionally resize before export", "Item",ExpressionUUID->"2c5dd7b0-95f0-4684-85c1-0791d36a9c3d"],

Cell[TextData[{
 "wrap failures with ",
 ButtonBox["Failure",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Failure"]
}], "Item",ExpressionUUID->"b22d984f-22ff-4c68-bd03-0c4c5d4c0c48"],

Cell["A more careful version might look like this: ", "CodeText",ExpressionUUID->"7b7a34b1-b75c-43da-af77-7cde91d161a3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"startMetricsSession", ",", "lpipsDistance"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"startMetricsSession", "[", 
    RowBox[{"pythonExecutable_String", ",", "moduleDirectory_String"}], "]"}],
    ":=", "\[IndentingNewLine]", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "session", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"session", "=", 
       RowBox[{"StartExternalSession", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<Python\>\"", ",", 
          RowBox[{"\"\<Evaluator\>\"", "->", "pythonExecutable"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"ExternalEvaluate", "[", "\[IndentingNewLine]", "   ", 
       RowBox[{"session", ",", "\[IndentingNewLine]", "   ", 
        RowBox[{
         RowBox[{
         "StringTemplate", "[", "\[IndentingNewLine]", 
          "     ", "\"\<import sys; sys.path.insert(0, r'''`dir`'''); import \
metrics_bridge\>\"", "\[IndentingNewLine]", "     ", "]"}], "[", 
         RowBox[{"<|", 
          RowBox[{"\"\<dir\>\"", "->", "moduleDirectory"}], "|>"}], "]"}]}], 
       "\[IndentingNewLine]", "   ", "]"}], ";", "\[IndentingNewLine]", "  ", 
      "session"}]}], "\[IndentingNewLine]", "  ", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lpipsDistance", "[", 
   RowBox[{"session_", ",", "image1_Image", ",", "image2_Image", ",", 
    RowBox[{"net_", ":", " ", "\"\<alex\>\""}]}], "]"}], ":=", 
  "\[IndentingNewLine]", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dir", ",", "file1", ",", "file2"}], "}"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"dir", "=", 
      RowBox[{"CreateDirectory", "[", "]"}]}], ";", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"file1", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"dir", ",", "\"\<image1.png\>\""}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"file2", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"dir", ",", "\"\<image2.png\>\""}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
     RowBox[{"WithCleanup", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"Export", "[", 
         RowBox[{"file1", ",", "image1"}], "]"}], ";", "\[IndentingNewLine]", 
        "   ", 
        RowBox[{"Export", "[", 
         RowBox[{"file2", ",", "image2"}], "]"}], ";", "\[IndentingNewLine]", 
        "   ", 
        RowBox[{"ExternalEvaluate", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{"session", ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"<|", "\[IndentingNewLine]", "      ", 
           RowBox[{
            
            RowBox[{"\"\<Command\>\"", 
             "->", "\"\<metrics_bridge.lpips_distance\>\""}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"\"\<Arguments\>\"", "->", 
             RowBox[{"{", 
              RowBox[{"file1", ",", "file2", ",", "net"}], "}"}]}]}], 
           "\[IndentingNewLine]", "      ", "|>"}]}], "\[IndentingNewLine]", 
         "    ", "]"}]}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"DeleteDirectory", "[", 
        RowBox[{"dir", ",", 
         RowBox[{"DeleteContents", "->", "True"}]}], "]"}]}], 
      "\[IndentingNewLine]", "   ", "]"}]}]}], "\[IndentingNewLine]", "  ", 
   "]"}]}]}], "Input",ExpressionUUID->"62714777-4c2e-476a-b610-e220a3fb2052"],

Cell["This is much closer to what I\[CloseCurlyQuote]d actually use. ", "Text",ExpressionUUID->"c7c29d40-02e1-4635-abc6-303e55ef804e"],

