Cell[CellGroupData[{

Cell["9. One likely issue: how WL locates Python", "Title",ExpressionUUID->"4c136df5-5aa6-41cf-9944-e1c18bb3cb51"],

Cell[TextData[{
 "If ",
 ButtonBox["StartExternalSession",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/StartExternalSession"],
 " does not accept the executable the way shown above in your version/setup, \
the fallback is to ",
 StyleBox["register",
  FontWeight->Bold],
 " the evaluator first and then start by name."
}], "Text",ExpressionUUID->"477d1732-f3b2-426d-8d60-21f7c7a0d5f8"],

Cell["The docs show patterns like: ", "Text",ExpressionUUID->"6746b9b1-99b0-4ab8-a87a-8b8b67b07a68"],

Cell["registering a Python evaluator with a name", "Item",ExpressionUUID->"c86e36c3-86f9-49a4-8d74-f26a16b565cd"],

Cell[TextData[{
 "starting via ",
 Cell[BoxData[
  RowBox[{"StartExternalSession", "[", 
   RowBox[{"{", 
    RowBox[{"\"\<Python\>\"", ",", 
     RowBox[{"\"\<Name\>\"", "->", "\"\<...\>\""}]}], "}"}], "]"}]], 
  "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "25bb4227-d8b6-495a-9779-48d1bb1af272"]
}], "Item",ExpressionUUID->"b753bcd5-e64f-489b-b39d-9dbc064113ac"],

Cell["\<\
So if direct executable specification is awkward, the robust alternative is:\
\>", "Text",ExpressionUUID->"aeb923c8-3720-4b1a-acf6-da75c1b4a154"],

Cell[TextData[{
 "1. register the ",
 StyleBox["uv", "TI"],
 " Python evaluator"
}], "Text",ExpressionUUID->"520a9bc8-6461-4539-8998-5de274dd01bc"],

Cell["2. start the named session", "Text",ExpressionUUID->"8c9c568f-3d1b-46b0-8916-4fdeba609884"],

Cell["3. import your module", "Text",ExpressionUUID->"08092f11-efcb-4c20-bea2-4d5a0fc0a066"],

Cell["That is often the cleanest long-term setup. ", "Text",ExpressionUUID->"ac3ed772-6faa-4bd8-8bcc-35fe22de5afc"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
