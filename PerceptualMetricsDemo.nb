Cell[CellGroupData[{

Cell["4. Spatial Perceptual Distance Maps", "Section",ExpressionUUID->"5a42b275-19fa-486f-8320-f5769a09847c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapAlex", "=", 
   RowBox[{"PerceptualSpatialMap", "[", 
    RowBox[{"img1", ",", "img2", ",", 
     RowBox[{"\"\<Metric\>\"", "->", "\"\<lpips\>\""}], ",", 
     RowBox[{"\"\<Net\>\"", "->", "\"\<alex\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mapVGG", "=", 
   RowBox[{"PerceptualSpatialMap", "[", 
    RowBox[{"img1", ",", "img2", ",", 
     RowBox[{"\"\<Metric\>\"", "->", "\"\<lpips\>\""}], ",", 
     RowBox[{"\"\<Net\>\"", "->", "\"\<vgg\>\""}]}], "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.995977200753652*^9, 3.9959772070789013`*^9}, 
   3.995977262731533*^9, 3.995979071646038*^9, 3.9959794457945747`*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"83454589-f2be-4182-92c4-f7ceb86d383b"],

