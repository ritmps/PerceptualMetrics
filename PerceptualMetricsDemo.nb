Cell[CellGroupData[{

Cell["2. Sample Images Setup", "Section",ExpressionUUID->"573a6a26-6857-4953-b73d-9b20853c9094"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"img1", "=", 
   RowBox[{"Rasterize", "[", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Hue", "[", "0.6", "]"}], ",", 
        RowBox[{"Disk", "[", "]"}]}], "}"}], "]"}], ",", 
     RowBox[{"ImageSize", "->", 
      RowBox[{"{", 
       RowBox[{"128", ",", "128"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"img2", "=", 
   RowBox[{"Blur", "[", 
    RowBox[{"img1", ",", "10"}], "]"}]}], ";", 
  RowBox[{"GraphicsRow", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"img1", ",", "img2"}], "}"}], ",", 
    RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}]], "Input",
