Cell[CellGroupData[{

Cell["5. Clean Up Session", "Section",ExpressionUUID->"e4738de9-9245-435d-87c9-f676ee1d338e"],

Cell["\<\
You don\[CloseCurlyQuote]t need to do this anymore - it is forced closed when \
you quit, but if you need to...\
\>", "Text",
 CellChangeTimes->{{3.996224632511486*^9, 
  3.9962246673690643`*^9}},ExpressionUUID->"18bb6668-aedb-4643-9ff0-\
15c3bf1f2edc"],

Cell[BoxData[
 RowBox[{"StopPerceptualSession", "[", "]"}]], "Input",
