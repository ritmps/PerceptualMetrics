Cell[BoxData[{
 RowBox[{
  RowBox[{"mapAlex", "=", 
   RowBox[{"PerceptualSpatialMap", "[", 
    RowBox[{"img1", ",", "img2", ",", 
     RowBox[{"\"\<Metric\>\"", "->", "\"\<lpips\>\""}], ",", 
     RowBox[{"\"\<Net\>\"", "->", "\"\<alex\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
