Cell["2. Start a persistent Python session and load the module", "Section",ExpressionUUID->"83573fa1-665e-45fd-a8cf-74b504dc46a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"session", "=", 
    RowBox[{"StartExternalSession", "[", 
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{"\"\<Python\>\"", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"\"\<Executable\>\"", "->", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<.venv\>\"", 
           ",", "\"\<bin\>\"", ",", "\"\<python\>\""}], "}"}], "]"}]}]}], 
      "\[IndentingNewLine]", "}"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExternalEvaluate", "[", 
   RowBox[{"session", ",", 
    RowBox[{"File", "[", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        ",", "\"\<lpips_bridge.py\>\""}], "}"}], "]"}], "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"7e8bf377-78dc-44a1-aca0-1bebbf71fcd9"],

Cell[TextData[{
 "This follows the documented pattern for ",
 ButtonBox["StartExternalSession",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/StartExternalSession"],
 " and ",
 ButtonBox["ExternalEvaluate",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ExternalEvaluate"],
 ". "
}], "Text",ExpressionUUID->"fb7ddae0-76d3-42ba-94a7-f942a6489e59"]
