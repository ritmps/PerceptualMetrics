      "\[IndentingNewLine]", "    ", 
      RowBox[{"\"\<Spatial\>\"", "->", "False"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
