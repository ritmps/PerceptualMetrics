Notebook[{

Cell[CellGroupData[{
Cell["Perceptual Metrics Demos & Examples", "Title",ExpressionUUID->"b5bbcf28-aca9-4e66-8afe-3d697d7c5ee4"],

Cell["\<\
This notebook demonstrates using PerceptualMetrics.wl to calculate LPIPS, L2, \
DSSIM, and PSNR metrics.\
\>", "Text",ExpressionUUID->"46f6d64b-9106-473d-aa70-27dd8b8f8e98"],

Cell[CellGroupData[{

Cell["0. Paclet style", "Section",
 CellChangeTimes->{{3.996224336841324*^9, 
  3.9962243412591267`*^9}},ExpressionUUID->"570329f9-ce52-44b4-914c-\
8ca6f4e6e174"],

Cell[BoxData[
 RowBox[{"Quit", "[", "]"}]], "Input",
 CellChangeTimes->{{3.995979406343305*^9, 3.9959794081161623`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"7479db47-fd8c-43d7-b810-bb405d868cce"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "PacletDirectoryLoad", "[", "\"\</Users/fxpppr/GitHub/PerceptualMetrics\>\"",
    "]"}], ";"}]], "Input",
 CellChangeTimes->{{3.996224399357696*^9, 3.996224405899879*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"3a4567d4-1d9d-4643-8b12-b2fa9baf9d21"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<PerceptualMetrics`\>\"", "]"}], ";"}], "\n", 
