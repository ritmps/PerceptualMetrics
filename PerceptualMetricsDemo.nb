Cell[CellGroupData[{

Cell["4. Spatial Perceptual Distance Maps", "Section",ExpressionUUID->"5a42b275-19fa-486f-8320-f5769a09847c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"mapAlex", "=", 
   RowBox[{"PerceptualSpatialMap", "[", 
    RowBox[{"session", ",", "img1", ",", "img2", ",", 
     RowBox[{"\"\<Metric\>\"", "->", "\"\<lpips\>\""}], ",", 
     RowBox[{"\"\<Net\>\"", "->", "\"\<alex\>\""}]}], "]"}]}], ";", 
  RowBox[{"mapVGG", "=", 
   RowBox[{"PerceptualSpatialMap", "[", 
    RowBox[{"session", ",", "img1", ",", "img2", ",", 
     RowBox[{"\"\<Metric\>\"", "->", "\"\<lpips\>\""}], ",", 
     RowBox[{"\"\<Net\>\"", "->", "\"\<vgg\>\""}]}], "]"}]}], ";", 
  RowBox[{"GraphicsRow", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Colorize", "[", 
       RowBox[{"mapAlex", ",", 
        RowBox[{"ColorFunction", "->", "\"\<Inferno\>\""}]}], "]"}], ",", 
      RowBox[{"Colorize", "[", 
       RowBox[{"mapVGG", ",", 
        RowBox[{"ColorFunction", "->", "\"\<Inferno\>\""}]}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"83454589-f2be-4182-92c4-f7ceb86d383b"],

