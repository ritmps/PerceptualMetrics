Cell[CellGroupData[{

Cell["3. Scalar Perceptual Metrics Comparison", "Section",ExpressionUUID->"b7f47d67-b20d-430e-9fd4-cc76f2d7ad60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", "[", 
  RowBox[{
   RowBox[{"\"\<LPIPS (Alex)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<alex\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<LPIPS (VGG)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<vgg\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<LPIPS (Squeeze)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<squeeze\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<L2 (Lab)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<l2\>\""}], ",", 
      RowBox[{"\"\<ColorSpace\>\"", "->", "\"\<Lab\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<DSSIM (Lab)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<dssim\>\""}], ",", 
      RowBox[{"\"\<ColorSpace\>\"", "->", "\"\<Lab\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<PSNR (dB)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<psnr\>\""}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{3.995979071645462*^9},
 CellLabel->"In[12]:=",ExpressionUUID->"4d6a5b8c-5379-4f8c-9b3d-e6ed78c62aa0"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"LPIPS (Alex)\"\>", "\[Rule]", "0.167707622051239`"}], ",", 
   RowBox[{"\<\"LPIPS (VGG)\"\>", "\[Rule]", "0.19008661806583405`"}], ",", 
