Cell[CellGroupData[{

Cell["6. Another Example", "Section",
 CellChangeTimes->{{3.99622822462549*^9, 
  3.9962282317797823`*^9}},ExpressionUUID->"609093da-ff4c-4cde-8612-\
1ef031c15ae7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"noiseK", "=", "0.1"}], ";"}]], "Input",
 CellChangeTimes->{{3.996228327151505*^9, 3.996228334490963*^9}, 
   3.996228379067091*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"0e73aaa8-d007-476a-9a7c-ab5fb4af48ae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"img1", "=", 
   RowBox[{"ExampleData", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<TestImage\>\"", ",", "\"\<Peppers\>\""}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"img2", "=", 
   RowBox[{"img1", "+", 
    RowBox[{"noiseK", "*", 
     RowBox[{"RandomImage", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"ImageDimensions", "[", "img1", "]"}]}], "]"}]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.996228255537704*^9, 3.996228322900148*^9}, {
  3.99622836679249*^9, 3.9962283685479937`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"e1d956d7-9514-4fb3-93ac-576ff469ad12"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", "[", 
  RowBox[{
   RowBox[{"\"\<LPIPS (Alex)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<alex\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<LPIPS (VGG)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<vgg\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<LPIPS (Squeeze)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<squeeze\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<L2 (Lab)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<l2\>\""}], ",", 
      RowBox[{"\"\<ColorSpace\>\"", "->", "\"\<Lab\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<DSSIM (Lab)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<dssim\>\""}], ",", 
      RowBox[{"\"\<ColorSpace\>\"", "->", "\"\<Lab\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<PSNR (dB)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<psnr\>\""}]}], "]"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{3.995979071645462*^9},
 CellLabel->"In[15]:=",ExpressionUUID->"d5fbbfd9-e03a-4d82-8db4-43281ddda2f7"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"LPIPS (Alex)\"\>", "\[Rule]", "0.1545196771621704`"}], ",", 
   RowBox[{"\<\"LPIPS (VGG)\"\>", "\[Rule]", "0.1946931928396225`"}], ",", 
   RowBox[{"\<\"LPIPS (Squeeze)\"\>", "\[Rule]", "0.10697703063488007`"}], ",", 
   RowBox[{"\<\"L2 (Lab)\"\>", "\[Rule]", "0.0005168651696294546`"}], ",", 
   RowBox[{"\<\"DSSIM (Lab)\"\>", "\[Rule]", "0.04411014914512634`"}], ",", 
