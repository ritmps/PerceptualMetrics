Cell[CellGroupData[{

Cell["10. Example images", "Section",ExpressionUUID->"90960b6a-6588-4163-a2d8-c6a56a7d456b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"img1", "=", 
   RowBox[{"Import", "[", "\"\<ExampleData/coneflower.jpg\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"img2", "=", 
   RowBox[{"ImageResize", "[", 
    RowBox[{
     RowBox[{"ImageTake", "[", 
      RowBox[{"img1", ",", 
       RowBox[{"{", 
        RowBox[{"20", ",", 
         RowBox[{"-", "20"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"20", ",", 
         RowBox[{"-", "20"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"ImageDimensions", "[", "img1", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
