            RowBox[{"image1", ",", "\"\<RGB\>\""}], "]"}], 
           ",", "\"\<Real\>\""}], "]"}], ",", "\[IndentingNewLine]", 
         "            ", 
         RowBox[{"ImageData", "[", 
          RowBox[{
           RowBox[{"ColorConvert", "[", 
            RowBox[{"image2", ",", "\"\<RGB\>\""}], "]"}], 
           ",", "\"\<Real\>\""}], "]"}], ",", "\[IndentingNewLine]", 
         "            ", 
         RowBox[{"OptionValue", "[", "\"\<Net\>\"", "]"}], ",", 
         "\[IndentingNewLine]", "            ", 
         RowBox[{"OptionValue", "[", "\"\<Version\>\"", "]"}], ",", 
         "\[IndentingNewLine]", "            ", 
         RowBox[{"OptionValue", "[", "\"\<Spatial\>\"", "]"}]}], 
        "\[IndentingNewLine]", "        ", "}"}]}]}], "\[IndentingNewLine]", 
     "    ", "|>"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"e0aab255-2672-4d6d-bfc7-c4f925bafb58"]
}, Open  ]],

