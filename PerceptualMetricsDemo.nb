Cell["3. Scalar Perceptual Metrics Comparison", "Section",ExpressionUUID->"b7f47d67-b20d-430e-9fd4-cc76f2d7ad60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", "[", 
  RowBox[{
   RowBox[{"\"\<LPIPS (Alex)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<alex\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<LPIPS (VGG)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<vgg\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<LPIPS (Squeeze)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<squeeze\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<L2 (Lab)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<l2\>\""}], ",", 
      RowBox[{"\"\<ColorSpace\>\"", "->", "\"\<Lab\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<DSSIM (Lab)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<dssim\>\""}], ",", 
      RowBox[{"\"\<ColorSpace\>\"", "->", "\"\<Lab\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<PSNR (dB)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<psnr\>\""}]}], "]"}]}]}], 
  "]"}]], "Input",
