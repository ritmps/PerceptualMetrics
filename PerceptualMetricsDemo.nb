Cell[CellGroupData[{

Cell["3. Session helper", "Section",ExpressionUUID->"cc446342-f19c-4610-a264-2736b625be82"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "startLPIPSSession", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"startLPIPSSession", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"python", ",", "s"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
    
    RowBox[{
     RowBox[{"python", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"NotebookDirectory", "[", "]"}], ",", "\"\<.venv\>\"", 
         ",", "\"\<bin\>\"", ",", "\"\<python\>\""}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"s", "=", 
      RowBox[{"StartExternalSession", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Python\>\"", ",", 
         RowBox[{"\"\<Executable\>\"", "->", "python"}]}], "}"}], "]"}]}], ";",
      "\[IndentingNewLine]", "    ", 
     RowBox[{"ExternalEvaluate", "[", 
      RowBox[{"s", ",", 
       RowBox[{"File", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], 
           ",", "\"\<lpips_bridge.py\>\""}], "}"}], "]"}], "]"}]}], "]"}], ";",
      "\[IndentingNewLine]", "    ", "s"}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"78c6ff71-4c72-4515-b2ef-9510e1c74c33"]
}, Open  ]],

