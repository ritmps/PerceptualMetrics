(* Beginning of Notebook Content *)
Notebook[{
Cell["Perceptual Metrics Demos & Examples", "Title",ExpressionUUID->"b5bbcf28-aca9-4e66-8afe-3d697d7c5ee4"],

Cell["\<\
This notebook demonstrates using PerceptualMetrics.wl to calculate LPIPS, L2, \
DSSIM, and PSNR metrics.\
\>", "Text",ExpressionUUID->"46f6d64b-9106-473d-aa70-27dd8b8f8e98"],

Cell["1. Package Initialization & Session Startup", "Section",ExpressionUUID->"5cabc5dd-d968-46e7-ab21-bf5402df8231"],

Cell[BoxData[
 RowBox[{"Off", "[", 
  RowBox[{"General", "::", "shdw"}], "]"}]], "Input",ExpressionUUID->\
"11ff66cd-749b-4adb-8255-1f97d2ea5daf"],

Cell[BoxData[
 RowBox[{"Get", "[", "\"\<PerceptualMetrics.wl\>\"", "]"}]], "Input",Expressio\
nUUID->"6717fe39-d514-49cb-a40e-1c5a3de3110d"],

Cell[BoxData[
 RowBox[{"session", "=", 
  RowBox[{"StartPerceptualSession", "[", "]"}]}]], "Input",ExpressionUUID->\
"8538815f-66cb-4126-9e8d-a046598f688d"],

Cell[BoxData[
 RowBox[{"PerceptualInfo", "[", "session", "]"}]], "Input",ExpressionUUID->"7ca1c331-28f0-432b-811b-2c333fea7205"],

Cell["2. Sample Images Setup", "Section",ExpressionUUID->"573a6a26-6857-4953-b73d-9b20853c9094"],

Cell[BoxData[
 RowBox[{
  RowBox[{"img1", "=", 
   RowBox[{"Rasterize", "[", 
    RowBox[{
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Hue", "[", "0.6", "]"}], ",", 
        RowBox[{"Disk", "[", "]"}]}], "}"}], "]"}], ",", 
     RowBox[{"ImageSize", "->", 
      RowBox[{"{", 
       RowBox[{"128", ",", "128"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"img2", "=", 
   RowBox[{"Blur", "[", 
    RowBox[{"img1", ",", "4"}], "]"}]}], ";", 
  RowBox[{"GraphicsRow", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"img1", ",", "img2"}], "}"}], ",", 
    RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}]], "Input",ExpressionUUID->\
"76136c5f-9d68-4ed4-b4fd-50189a9f11c7"],

Cell["3. Scalar Perceptual Metrics Comparison", "Section",ExpressionUUID->"b7f47d67-b20d-430e-9fd4-cc76f2d7ad60"],

Cell[BoxData[
 RowBox[{"Association", "[", 
  RowBox[{
   RowBox[{"\"\<LPIPS (Alex)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<alex\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<LPIPS (VGG)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<vgg\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<LPIPS (Squeeze)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Net\>\"", "->", "\"\<squeeze\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<L2 (Lab)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<l2\>\""}], ",", 
      RowBox[{"\"\<ColorSpace\>\"", "->", "\"\<Lab\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<DSSIM (Lab)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<dssim\>\""}], ",", 
      RowBox[{"\"\<ColorSpace\>\"", "->", "\"\<Lab\>\""}]}], "]"}]}], ",", 
   RowBox[{"\"\<PSNR (dB)\>\"", "->", 
    RowBox[{"PerceptualDistance", "[", 
     RowBox[{"session", ",", "img1", ",", "img2", ",", 
      RowBox[{"\"\<Metric\>\"", "->", "\"\<psnr\>\""}]}], "]"}]}]}], 
  "]"}]], "Input",ExpressionUUID->"4d6a5b8c-5379-4f8c-9b3d-e6ed78c62aa0"],

Cell["4. Spatial Perceptual Distance Maps", "Section",ExpressionUUID->"5a42b275-19fa-486f-8320-f5769a09847c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mapAlex", "=", 
   RowBox[{"PerceptualSpatialMap", "[", 
    RowBox[{"session", ",", "img1", ",", "img2", ",", 
     RowBox[{"\"\<Metric\>\"", "->", "\"\<lpips\>\""}], ",", 
     RowBox[{"\"\<Net\>\"", "->", "\"\<alex\>\""}]}], "]"}]}], ";", 
  RowBox[{"mapVGG", "=", 
   RowBox[{"PerceptualSpatialMap", "[", 
    RowBox[{"session", ",", "img1", ",", "img2", ",", 
     RowBox[{"\"\<Metric\>\"", "->", "\"\<lpips\>\""}], ",", 
     RowBox[{"\"\<Net\>\"", "->", "\"\<vgg\>\""}]}], "]"}]}], ";", 
  RowBox[{"GraphicsRow", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Colorize", "[", 
       RowBox[{"mapAlex", ",", 
        RowBox[{"ColorFunction", "->", "\"\<Inferno\>\""}]}], "]"}], ",", 
      RowBox[{"Colorize", "[", 
       RowBox[{"mapVGG", ",", 
        RowBox[{"ColorFunction", "->", "\"\<Inferno\>\""}]}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]], "Input",ExpressionUUID->\
"83454589-f2be-4182-92c4-f7ceb86d383b"],

Cell["5. Clean Up Session", "Section",ExpressionUUID->"e4738de9-9245-435d-87c9-f676ee1d338e"],

Cell[BoxData[
 RowBox[{"StopPerceptualSession", "[", "session", "]"}]], "Input",ExpressionUU\
ID->"54bb6ab1-830f-41ba-be1e-6d676fbd5a52"]
},
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (July 2, 2026)",
StyleDefinitions->"Default.nb",
ExpressionUUID->"fd983b68-5c77-44a4-909c-784f4b74a76e"
]
