Cell[CellGroupData[{

Cell["5. Safe temporary-file helper", "Section",ExpressionUUID->"b3fc9ceb-38df-43ee-9894-8c10aedbe8b8"],

Cell["\<\
This creates a per-call temporary directory and guarantees cleanup. \
\>", "Text",ExpressionUUID->"46c77055-fbc4-416f-99af-92d8044c8cc9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "withTemporaryPairFiles", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"withTemporaryPairFiles", "[", 
   RowBox[{"image1_Image", ",", "image2_Image", ",", "body_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "    ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dir", ",", "file1", ",", "file2"}], "}"}], ",", 
    "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"dir", "=", 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"$TemporaryDirectory", ",", 
          RowBox[{"CreateUUID", "[", "\"\<lpips-\>\"", "]"}]}], "}"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "    ", 
     RowBox[{"file1", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"dir", ",", "\"\<image1.png\>\""}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"file2", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"dir", ",", "\"\<image2.png\>\""}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"Export", "[", 
      RowBox[{"file1", ",", "image1", ",", "\"\<PNG\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"Export", "[", 
      RowBox[{"file2", ",", "image2", ",", "\"\<PNG\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{
     "Internal`WithLocalSettings", "[", "\[IndentingNewLine]", "        ", 
      RowBox[{"Null", ",", "\[IndentingNewLine]", "        ", 
       RowBox[{"body", "[", 
        RowBox[{"file1", ",", "file2"}], "]"}], ",", "\[IndentingNewLine]", 
       "        ", 
       RowBox[{"Quiet", " ", "@", " ", 
        RowBox[{"DeleteDirectory", "[", 
         RowBox[{"dir", ",", 
          RowBox[{"DeleteContents", "->", "True"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "    ", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"44c065d0-0345-4e38-af96-87da76884943"],

Cell[TextData[{
 "Uses ",
 ButtonBox["DeleteContents",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/DeleteContents"],
 " with ",
 ButtonBox["DeleteDirectory",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/DeleteDirectory"],
 " semantics for cleanup. "
}], "Text",ExpressionUUID->"aac6a837-e5b4-4b8f-b530-6460761b8bb8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. File-based LPIPS wrapper", "Section",ExpressionUUID->"fe0596d1-7d67-45af-b5ea-9ac1f95904be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "lpipsDistance", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "lpipsDistance", "]"}], "=", 
    RowBox[{"{", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"\"\<Net\>\"", "->", "\"\<alex\>\""}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"\"\<Version\>\"", "->", "\"\<0.1\>\""}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"\"\<Spatial\>\"", "->", "False"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lpipsDistance", "[", "\[IndentingNewLine]", "    ", 
   RowBox[{
   "session_", ",", "\[IndentingNewLine]", "    ", "image1_Image", ",", 
    "\[IndentingNewLine]", "    ", "image2_Image", ",", "\[IndentingNewLine]",
     "    ", 
    RowBox[{"opts", " ", ":", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], ":=", 
  RowBox[{"withTemporaryPairFiles", "[", "\[IndentingNewLine]", "    ", 
   RowBox[{
    RowBox[{"ColorConvert", "[", 
     RowBox[{"image1", ",", "\"\<RGB\>\""}], "]"}], ",", 
    "\[IndentingNewLine]", "    ", 
    RowBox[{"ColorConvert", "[", 
     RowBox[{"image2", ",", "\"\<RGB\>\""}], "]"}], ",", 
    "\[IndentingNewLine]", "    ", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"file1", ",", "file2"}], "}"}], ",", "\[IndentingNewLine]", 
      "        ", 
      RowBox[{
      "ExternalEvaluate", "[", "\[IndentingNewLine]", "            ", 
       RowBox[{"session", ",", "\[IndentingNewLine]", "            ", 
        RowBox[{"<|", "\[IndentingNewLine]", "                ", 
         RowBox[{
          RowBox[{"\"\<Command\>\"", "->", "\"\<lpips_distance\>\""}], ",", 
          "\[IndentingNewLine]", "                ", 
          RowBox[{"\"\<Arguments\>\"", "->", 
           RowBox[{"{", "\[IndentingNewLine]", "                    ", 
            RowBox[{
            "file1", ",", "\[IndentingNewLine]", "                    ", 
             "file2", ",", "\[IndentingNewLine]", "                    ", 
             RowBox[{"OptionValue", "[", "\"\<Net\>\"", "]"}], ",", 
             "\[IndentingNewLine]", "                    ", 
             RowBox[{"OptionValue", "[", "\"\<Version\>\"", "]"}], ",", 
             "\[IndentingNewLine]", "                    ", 
             RowBox[{"OptionValue", "[", "\"\<Spatial\>\"", "]"}]}], 
            "\[IndentingNewLine]", "                ", "}"}]}]}], 
         "\[IndentingNewLine]", "            ", "|>"}]}], 
       "\[IndentingNewLine]", "        ", "]"}]}], "\[IndentingNewLine]", 
     "    ", "]"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"c68146f3-bc25-495b-a487-229c625f52df"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Batch file-based wrapper", "Section",ExpressionUUID->"f7624411-cfdd-4a12-9b84-e5998270c054"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "lpipsDistanceBatch", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "lpipsDistanceBatch", "]"}], "=", 
    RowBox[{"{", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"\"\<Net\>\"", "->", "\"\<alex\>\""}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"\"\<Version\>\"", "->", "\"\<0.1\>\""}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"\"\<Spatial\>\"", "->", "False"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lpipsDistanceBatch", "[", "\[IndentingNewLine]", "    ", 
   RowBox[{"session_", ",", "\[IndentingNewLine]", "    ", 
    RowBox[{"imagePairs", " ", ":", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"_Image", ",", "_Image"}], "}"}], " ", ".."}], "}"}]}], ",", 
    "\[IndentingNewLine]", "    ", 
    RowBox[{"opts", " ", ":", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dirs", ",", "pairs"}], "}"}], ",", "\[IndentingNewLine]", 
    "    ", 
    RowBox[{
     RowBox[{"dirs", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", "        ", 
       RowBox[{
        RowBox[{"CreateDirectory", "[", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"$TemporaryDirectory", ",", 
            RowBox[{"CreateUUID", "[", "\"\<lpips-\>\"", "]"}]}], "}"}], 
          "]"}], "]"}], ",", "\[IndentingNewLine]", "        ", 
        RowBox[{"{", 
         RowBox[{"Length", "[", "imagePairs", "]"}], "}"}]}], 
       "\[IndentingNewLine]", "    ", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"pairs", "=", 
      RowBox[{"MapThread", "[", "\[IndentingNewLine]", "        ", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"pair", ",", "dir"}], "}"}], ",", "\[IndentingNewLine]", 
          "            ", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"file1", "=", 
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"dir", ",", "\"\<image1.png\>\""}], "}"}], "]"}]}], ",", 
              RowBox[{"file2", "=", 
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"dir", ",", "\"\<image2.png\>\""}], "}"}], "]"}]}]}],
              "}"}], ",", "\[IndentingNewLine]", "                ", 
            RowBox[{
             RowBox[{"Export", "[", 
              RowBox[{"file1", ",", 
               RowBox[{"ColorConvert", "[", 
                RowBox[{
                 RowBox[{"pair", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<RGB\>\""}], "]"}],
                ",", "\"\<PNG\>\""}], "]"}], ";", "\[IndentingNewLine]", 
             "                ", 
             RowBox[{"Export", "[", 
              RowBox[{"file2", ",", 
               RowBox[{"ColorConvert", "[", 
                RowBox[{
                 RowBox[{"pair", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<RGB\>\""}], "]"}],
                ",", "\"\<PNG\>\""}], "]"}], ";", "\[IndentingNewLine]", 
             "                ", 
             RowBox[{"{", 
              RowBox[{"file1", ",", "file2"}], "}"}]}]}], 
           "\[IndentingNewLine]", "            ", "]"}]}], 
         "\[IndentingNewLine]", "        ", "]"}], ",", "\[IndentingNewLine]",
         "        ", 
        RowBox[{"{", 
         RowBox[{"imagePairs", ",", "dirs"}], "}"}]}], "\[IndentingNewLine]", 
       "    ", "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{
     "Internal`WithLocalSettings", "[", "\[IndentingNewLine]", "        ", 
      RowBox[{"Null", ",", "\[IndentingNewLine]", "        ", 
       RowBox[{"ExternalEvaluate", "[", "\[IndentingNewLine]", "            ", 
        RowBox[{"session", ",", "\[IndentingNewLine]", "            ", 
         RowBox[{"<|", "\[IndentingNewLine]", "                ", 
          RowBox[{
           RowBox[{"\"\<Command\>\"", "->", "\"\<lpips_distance_batch\>\""}], 
           ",", "\[IndentingNewLine]", "                ", 
           RowBox[{"\"\<Arguments\>\"", "->", 
            RowBox[{"{", "\[IndentingNewLine]", "                    ", 
             RowBox[{
             "pairs", ",", "\[IndentingNewLine]", "                    ", 
              RowBox[{"OptionValue", "[", "\"\<Net\>\"", "]"}], ",", 
              "\[IndentingNewLine]", "                    ", 
              RowBox[{"OptionValue", "[", "\"\<Version\>\"", "]"}], ",", 
              "\[IndentingNewLine]", "                    ", 
              RowBox[{"OptionValue", "[", "\"\<Spatial\>\"", "]"}]}], 
             "\[IndentingNewLine]", "                ", "}"}]}]}], 
          "\[IndentingNewLine]", "            ", "|>"}]}], 
        "\[IndentingNewLine]", "        ", "]"}], ",", "\[IndentingNewLine]", 
       "        ", 
       RowBox[{"Scan", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Quiet", " ", "@", " ", 
           RowBox[{"DeleteDirectory", "[", 
            RowBox[{"#", ",", 
             RowBox[{"DeleteContents", "->", "True"}]}], "]"}]}], " ", "&"}], 
         ",", "dirs"}], "]"}]}], "\[IndentingNewLine]", "    ", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"83d0e370-4935-4210-868c-ce7b9e4fda47"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Array-based wrapper", "Section",ExpressionUUID->"da6208d6-c710-4a8e-9563-5cd9d6a8b9be"],

Cell["\<\
This avoids PNG export and is the likely best long-term interface. \
\>", "Text",ExpressionUUID->"422d3fd5-d332-409a-9e0b-68fbba8b56c5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "lpipsDistanceArray", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
